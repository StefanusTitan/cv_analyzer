# CV analysis secrets
# Populate these only in the deployed staging environment. Never commit real values.
DASHSCOPE_API_KEY=
GITHUB_ACCESS_TOKEN=
SCRAPER_WORKER_TOKEN=
SCRAPER_WORKER_URL=http://scraper_worker:8010
SCRAPE_PROXY_URL=http://egress_proxy:3128
LOG_FILE_ENABLED=false
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# HRMS

# Logging
LOG_MASKING_ENABLED=true
LOG_MASK_FIELDS=token,password,secret,authorization,access_token,refresh_token,api_key
LOG_UNMASK_FIELDS=
LOG_MAX_VALUE_LENGTH=2000
LOG_MAX_COLLECTION_ITEMS=30
LOG_MAX_BODY_PREVIEW_LENGTH=1000
LOG_PRETTY_JSON=true
